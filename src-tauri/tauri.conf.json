{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MellowDLP",
  "version": "2.14.2",
  "identifier": "io.github.jenox645.mellowdlp",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/64x64.png",
      "icons/32x32.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mellowdlp"
        ]
      }
    }
  }
}
